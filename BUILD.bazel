load("@pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_uv//uv:pip.bzl", "pip_compile")

_GARMIN_SRCS = [
    "src/garmin/client.py",
    "src/garmin/cli.py",
    "dev/workspace.py",
]

pip_compile(
    name = "requirements",
    requirements_in = "//:requirements.in",
    requirements_txt = "//:requirements.txt",
)

py_binary(
    name = "ruff",
    srcs = ["dev/ruff_main.py"],
    main = "dev/ruff_main.py",
    deps = [requirement("ruff")],
)

py_binary(
    name = "generate_workouts",
    srcs = [
        "src/generate_workouts.py",
        "dev/workspace.py",
    ],
)

py_binary(
    name = "estimate_duration",
    srcs = [
        "src/estimate_duration.py",
        "dev/workspace.py",
    ],
)

py_binary(
    name = "garmin_push",
    srcs = _GARMIN_SRCS,
    main = "src/garmin/cli.py",
    deps = [requirement("garth")],
)

py_test(
    name = "client_test",
    srcs = [
        "src/garmin/client.py",
        "tests/garmin/client_test.py",
        "dev/workspace.py",
    ],
    main = "tests/garmin/client_test.py",
    deps = [
        requirement("garth"),
        requirement("pytest"),
    ],
)

py_test(
    name = "cli_test",
    srcs = _GARMIN_SRCS + ["tests/garmin/cli_test.py"],
    main = "tests/garmin/cli_test.py",
    deps = [
        requirement("garth"),
        requirement("pytest"),
    ],
)
